{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soyboy-payload",
  // Not `.open-next/worker.js` directly: a Cron Trigger needs a `scheduled`
  // export sitting on the same default export as `fetch`, and OpenNext
  // regenerates its worker on every build. `worker.ts` wraps it — see the file
  // for what it must keep re-exporting.
  "main": "worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Single front door: the CMS is only reachable at its custom domain
  // (cms.soyboy.saajanpatel.co.uk) — no duplicate *.workers.dev origin serving
  // the admin + API. The frontend reaches it via the BACKEND service binding.
  "workers_dev": false,
  // Payload makes several sequential DB round-trips per request; smart placement
  // runs the Worker near Hyperdrive/Neon (eu-west-2) instead of near the visitor.
  "placement": { "mode": "smart" },
  // Persisted logs + metrics in the dashboard (not just live tail).
  "observability": { "enabled": true },
  // Recipe of the day, rotated at 00:00 UTC. This — not `jobs.autoRun` — is what
  // fires the rotation in production: Payload's scheduler needs a process that
  // stays alive between requests, and Workers has none. The cron drives
  // `scheduled` in worker.ts, which POSTs `/cron/rotate-recipe-of-the-day`.
  //
  // Keep in step with the `schedule` on `src/tasks/rotateRecipeOfTheDay.ts`,
  // which documents the same cadence for the job runner.
  //
  // Needs `wrangler secret put CRON_SECRET` on this Worker — the route rejects
  // the trigger without it, and the scheduled handler throws rather than call an
  // endpoint it cannot authenticate to.
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Non-secret runtime config.
  //
  // Everything else this Worker needs is a credential and must be set with
  // `wrangler secret put <NAME>`, never committed here:
  //   PAYLOAD_SECRET
  //   CF_CACHE_PURGE_TOKEN
  //   CRON_SECRET
  //   S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
  //
  // These are secrets on this Worker rather than vars, unlike the sibling
  // repos where the non-secret half (PAYLOAD_URL, FRONTEND_URL, S3_BUCKET_NAME,
  // S3_REGION, S3_ENDPOINT_URL) lives in this block: they were set as secrets
  // when the Worker was first deployed, and a var and a secret of the same name
  // conflict on deploy. Moving them means deleting the secret in the same
  // change — worth doing, but not silently.
  //
  //   wrangler secret put PAYLOAD_SECRET
  //   wrangler secret put CF_CACHE_PURGE_TOKEN
  //   wrangler secret put CRON_SECRET
  "vars": {
    // The zone that serves the public site, for purge-on-publish. Not a secret
    // — the token that goes with it is, and must be scoped to
    // Zone -> Cache Purge -> Purge on this zone alone and nothing else.
    //
    // Find it on the zone's dashboard overview (saajanpatel.co.uk), then paste
    // it below. Until BOTH this and CF_CACHE_PURGE_TOKEN are set, the purge
    // hook no-ops and content changes wait out the edge TTL — a day — instead
    // of appearing in seconds. See docs/cloudflare-payload-stack.md -> Edge
    // caching and purge-on-publish.
    "CF_ZONE_ID": "4cd23c61040cbc255c1b88be7a81a985"
  },
  // Service binding to the Nuxt frontend Worker — lets Payload call the frontend
  // worker-to-worker over Cloudflare's internal network (no public hop, no
  // egress) via env.FRONTEND.fetch(). The reciprocal BACKEND binding lives in
  // apps/frontend/wrangler.jsonc, so the two Workers point at each other.
  "services": [
    {
      "binding": "FRONTEND",
      "service": "soyboy-frontend"
    }
  ],
  // Hyperdrive: edge connection pooling + query caching in front of Neon.
  // Use Neon's DIRECT (non-pooled) connection string — Hyperdrive does the
  // pooling itself. Create the config, then paste the returned id below:
  //   npx wrangler hyperdrive create soyboy-payload \
  //     --connection-string="postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require"
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eb2a5245edf84b6b943aac5e9089ff2a",
      // localConnectionString lets `wrangler dev` hit local Postgres directly
      // instead of the remote Hyperdrive config (swap for Neon to dev against it).
      "localConnectionString": "postgresql://postgres:payload@localhost:5432/payload-soyboy"
    }
  ]
}
