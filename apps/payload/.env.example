# --- Database -------------------------------------------------------------
# Local dev, the Payload CLI and `next build` read this. On Workers the
# connection comes from the HYPERDRIVE binding in wrangler.jsonc instead, and
# this variable is genuinely absent — payload.config.ts resolves whichever is
# available and fails loudly if neither is.
#
# Point Hyperdrive at Neon's DIRECT (non-pooled) string; Hyperdrive does the
# pooling itself:
#   npx wrangler hyperdrive create soyboy-payload \
#     --connection-string="postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require"
DATABASE_URL=postgresql://postgres:payload@postgres:5432/payload-soyboy
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- URLs -----------------------------------------------------------------
# FRONTEND_URL is both the CORS/CSRF allowlist and the origin the purge hook
# builds its URLs against. If it is wrong, purges quietly miss.
FRONTEND_URL=http://localhost:4000
PAYLOAD_URL=http://localhost:3000

# --- Cache purge ----------------------------------------------------------
# Purge-on-publish. Without BOTH of these the hook no-ops, and content changes
# wait out the edge TTL — a day — instead of appearing in seconds.
#
# Leave them unset locally: there is no edge cache in front of localhost, and a
# purge fired from a dev machine would clear production's.
#
# In production they are set in two different places, because only one of them
# is a credential:
#   CF_ZONE_ID           -> "vars" in wrangler.jsonc (an identifier, committed)
#   CF_CACHE_PURGE_TOKEN -> wrangler secret put CF_CACHE_PURGE_TOKEN
#
# The token needs exactly one permission — Zone → Cache Purge → Purge, scoped to
# this zone alone. Nothing else. CF_ZONE_ID is on the zone's dashboard overview.
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=

# --- Object storage (S3-compatible; R2 in production) ---------------------
# All five together or none at all — payload.config.ts rejects a partial set,
# because a half-configured bucket silently falls back to local disk, and on
# Workers that means uploads that appear to save and cannot be read back.
#   S3_REGION       -> "auto" for R2
#   S3_ENDPOINT_URL -> https://<account_id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY -> R2 API token (S3 credentials)
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_REGION=auto
S3_BUCKET_NAME=soyboy-media
S3_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# On Workers, these split three ways. Getting the split wrong is not a style
# question — a value in the wrong place fails silently:
#
#   Secrets     `wrangler secret put <NAME>` — runtime only, never in this file.
#               PAYLOAD_SECRET, CF_CACHE_PURGE_TOKEN, the S3_* credentials.
#
#   Vars        Plain values, set in BOTH places: Workers Builds -> Variables
#               (build time) and the Worker's own Variables (runtime).
#               PAYLOAD_URL, FRONTEND_URL.
#
#   Build-only  Needed by `next build`/`payload migrate` on the build machine,
#               not by the running Worker: DATABASE_URL. (PAYLOAD_SECRET is
#               needed in both, which is why it appears above as well.)
#
# PAYLOAD_URL and FRONTEND_URL must be vars, not secrets, and must exist at
# build time as well as runtime. `serverURL` is baked into the admin's client
# bundle by `next build`, and Workers Builds cannot read `wrangler secret`
# values — so a runtime-only value still reaches the browser as
# http://localhost:3000: every admin image is blocked by the CSP (`img-src`
# allows https:, not http:), every save fails CSRF with "You are not allowed to
# perform this action", and an empty FRONTEND_URL silently disables
# purge-on-publish. payload.config.ts refuses to build in production without
# them. See docs/cloudflare-builds.md.
