{
  "name": "@soyboy/payload",
  "version": "0.0.1",
  "private": true,
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "pnpm generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "check-types": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx src/seed/run.ts",
    "seed:prod": "bash scripts/seed-prod.sh",
    "db:clear-dev-marker": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx ./src/seed/clear-dev-migration.ts",
    "cf:build": "pnpm generate:importmap && cross-env CI=true NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --turbopack && cross-env CI=true NODE_OPTIONS=--no-deprecation opennextjs-cloudflare build --skipNextBuild",
    "cf:migrate": "node scripts/confirm.mjs migrate && cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/confirm.mjs deploy && pnpm cf:build && cross-env CONFIRM=migrate pnpm cf:migrate && opennextjs-cloudflare deploy",
    "cf:ci:build": "pnpm cf:build",
    "cf:ci:deploy": "cross-env CONFIRM=migrate pnpm cf:migrate && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "pnpm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@soyboy/shared": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.3",
    "payload": "3.84.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "^11"
  }
}
