# Where to reach Payload when the BACKEND service binding is not available —
# local dev, and any non-Workers host. In production the binding handles every
# request and this URL is never used, which is what keeps the CMS origin out of
# the browser.
PAYLOAD_URL=http://localhost:3000

# Canonical origin for absolute URLs in meta tags, JSON-LD and the sitemap.
# Defaults to the production domain, so it only needs setting on a preview
# deployment that should advertise its own address.
# NUXT_PUBLIC_SITE_URL=https://soyboy.saajanpatel.co.uk
